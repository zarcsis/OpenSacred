{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/rust_checks.py\" fmt",
            "timeout": 60,
            "statusMessage": "cargo fmt"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/rust_checks.py\" check",
            "timeout": 900,
            "statusMessage": "clippy and tests of the changed crates"
          }
        ]
      }
    ]
  }
}
