{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project python -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/merge_guard.py\"",
            "timeout": 60,
            "statusMessage": "merge guard"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project python -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/rust_checks.py\" fmt",
            "timeout": 60,
            "statusMessage": "cargo fmt"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project python -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/rust_checks.py\" check",
            "timeout": 900,
            "statusMessage": "clippy and tests of the changed crates"
          }
        ]
      }
    ]
  }
}
